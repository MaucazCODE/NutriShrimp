<?xml version="1.0" encoding="utf-8"?>
<!--
    Lampara del panel de estado. La forma es unica y el color lo pone cada
    piloto con android:backgroundTint, asi no hace falta un drawable por color.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/piloto_borde" />
</shape>

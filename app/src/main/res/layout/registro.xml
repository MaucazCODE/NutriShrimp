<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:backgroundTint="@color/fondo">

    <include
        android:id="@+id/panelEstado"
        layout="@layout/panel_estado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollRegistro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/panelEstado">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/encabezado_registro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="HISTÓRICO"
                android:textAlignment="center"
                android:textColor="@color/letras"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitulo_registro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Últimas 12 muestras · 1 cada 5 s"
                android:textAlignment="center"
                android:textColor="@color/grafico_texto_tenue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingLeft="20dp"
                android:text="Temperatura (°C)"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.app_alimentador.BarChartView
                android:id="@+id/graficoTemperatura"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp" />

            <TableLayout
                android:id="@+id/tablaTemperatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingLeft="20dp"
                android:text="Nivel de Sonido (%)"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.app_alimentador.BarChartView
                android:id="@+id/graficoSonido"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp" />

            <TableLayout
                android:id="@+id/tablaSonido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingLeft="20dp"
                android:text="Nivel de pH"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.app_alimentador.BarChartView
                android:id="@+id/graficoPh"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp" />

            <TableLayout
                android:id="@+id/tablaPh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp" />

            <!-- Bitacora de alimentacion. Va aparte de los tres graficos de
                 arriba porque no es una serie de tiempo regular: cada barra es
                 una descarga suelta y el eje X son horas de reloj, no segundos
                 hacia atras. Se vacia en cada inicio de sesion. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="20dp"
                android:background="@color/grafico_eje" />

            <TextView
                android:id="@+id/encabezado_alimentacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingLeft="20dp"
                android:text="@string/tituloRegistroAlimentacion"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitulo_alimentacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="20dp"
                android:text="@string/subtituloRegistroAlimentacion"
                android:textAlignment="viewStart"
                android:textColor="@color/grafico_texto_tenue"
                android:textSize="13sp" />

            <com.example.app_alimentador.AlimentacionChartView
                android:id="@+id/graficoAlimentacion"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="12dp" />

            <TextView
                android:id="@+id/totalAlimentacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:textAlignment="viewEnd"
                android:textColor="@color/grafico_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
